{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Frontend",
            "command": "npm run dev",
            "request": "launch",
            "type": "node-terminal",
            "cwd": "${workspaceFolder}/front",
        }, {
            "name": "Backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/back",
            "args": [
                "app.main:app",
                "--reload"
            ],
            "jinja": true
        },
        {
            "name": "Alembic migration",
            "command": "alembic revision --autogenerate -m \"${input:alemMsg}\" && alembic upgrade head",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/back",
        },
        {
            "name": "Generate API client",
            "command": "npm run generate",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/front",
        }
    ],
    "inputs": [
        {
          "id": "alemMsg",
          "type": "promptString",
          "description": "Alembic migration message",
        }
    ]
}