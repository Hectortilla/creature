{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Frontend",
            "command": "npm run dev",
            "request": "launch",
            "type": "node-terminal",
            "cwd": "${workspaceFolder}/front",
        }, {
            "name": "Backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/back",
            "args": [
                "app.main:app",
                "--reload"
            ],
            "jinja": true
        }
    ]
}