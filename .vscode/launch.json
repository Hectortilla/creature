{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Frontend",
            "command": "npm run dev -- --host",
            "request": "launch",
            "type": "node-terminal",
            "cwd": "${workspaceFolder}/front",
        }, {
            "name": "Backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/back",
            "args": [
                "app.main:app",
                "--reload"
            ],
            "jinja": true
        },
        {
            "name": "Alembic miragte",
            "command": "uv run alembic upgrade head",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/back",
        },
        {
            "name": "Alembic generate",
            "command": "uv run alembic revision --autogenerate -m \"${input:alemMsg}\"",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/back",
        },
        {
            "name": "Generate API client",
            "command": "npm run generate",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/front",
        },
        {
            "name": "E2E: Playwright UI (GUI)",
            "command": "npm run test:e2e:ui",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/front",
        },
        {
            "name": "E2E: Playwright (headed)",
            "command": "npm run test:e2e:headed",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/front",
        },
        {
            "name": "E2E: Playwright (all, headless)",
            "command": "npm run test:e2e",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/front",
        }
    ],
    "inputs": [
        {
          "id": "alemMsg",
          "type": "promptString",
          "description": "Alembic migration message",
        }
    ]
}