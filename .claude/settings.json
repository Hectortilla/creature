{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GRAPHITE_PROFILE": "pers",
    "GIT_SSH_COMMAND": "ssh -i ~/.ssh/id_ed25519_hec -o IdentitiesOnly=yes"
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run lint-imports)",
      "Bash(uv sync)",
      "Bash(npm run lint)",
      "Bash(npm run check)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run deps:check)",
      "Bash(npm run generate:*)",
      "Bash(pre-commit run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.sh\""
          }
        ]
      }
    ]
  }
}
